PORT=4000
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
# Stripe sandbox (leave empty = payments auto-succeed in dev "mock" mode)
STRIPE_SECRET_KEY=
# SMTP (leave empty = emails are logged to console). e.g. Mailtrap sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FleetCare <no-reply@fleetcare.local>
# Minutes before an unanswered (pending) request expires
REQUEST_TIMEOUT_MIN=10
# Login protection: failed attempts allowed, then cooldown in seconds
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=30
# Run `npm run vapid` and paste keys (leave empty = push disabled)
VAPID_PUBLIC=
VAPID_PRIVATE=
