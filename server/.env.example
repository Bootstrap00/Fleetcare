PORT=4000
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
# Stripe sandbox (leave empty = payments auto-succeed in dev "mock" mode)
STRIPE_SECRET_KEY=
# SMTP (leave empty = emails are logged to console). e.g. Mailtrap sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FleetCare <no-reply@fleetcare.local>
# Minutes before an unanswered (pending) request expires
REQUEST_TIMEOUT_MIN=10
# Login protection: failed attempts allowed, then cooldown in seconds
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=30
# PayMongo (Philippines): makes GCash, Maya and card payments real. Motorists are sent to the GCash/Maya app or card page,
# and FleetCare marks the request paid automatically. Get a key at dashboard.paymongo.com (sk_test_... for testing, sk_live_... for real money).
# Leave empty = card is hidden and GCash/Maya use manual transfer + reference. Cash on Service always needs the mechanic to confirm.
PAYMONGO_SECRET_KEY=
# Payment options offered to motorists (comma separated): cash,gcash,maya,card,bank
PAY_METHODS=cash,gcash,maya,card,bank
# Where motorists send e-wallet / bank payments. Shown in the payment dialog.
GCASH_NAME=FleetCare
GCASH_NUMBER=0917 000 0000
MAYA_NAME=FleetCare
MAYA_NUMBER=0918 000 0000
BANK_NAME=BDO
BANK_ACCOUNT_NAME=FleetCare Inc.
BANK_ACCOUNT_NUMBER=0000 0000 0000
# Run `npm run vapid` and paste keys (leave empty = push disabled)
VAPID_PUBLIC=
VAPID_PRIVATE=
